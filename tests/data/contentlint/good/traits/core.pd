format_version = 1

# A small complete corpus for the contentlint tests: valid objects, references that resolve, and
# every localisation key referenced from here (the unused-key check stays quiet).

trait "greedy" {
    name_key = "trait.greedy.name"
    desc_key = "trait.greedy.desc"
    slot = 1
    category = personality
    opposite = trait:generous
}

trait "generous" {
    name_key = "trait.generous.name"
    desc_key = "trait.generous.desc"
    slot = 2
    category = personality
    opposite = trait:greedy
}
