/* RmlUi has no built-in user-agent stylesheet: block-level elements must be declared. */
h1, h2, p, div {
    display: block;
}

body {
    font-family: "PT Sans Caption";
    font-size: 15dp;
    color: $light;
}

#panel {
    position: absolute;
    left: 16dp;
    top: 16dp;
    width: 380dp;
    padding: 12dp 14dp;
    background-color: $ink_a90;
    border: 1dp $gold;
    border-radius: 4dp;
}

h1 {
    font-family: "PT Serif";
    font-size: 22dp;
    font-weight: bold;
    color: $gold;
    margin-bottom: 8dp;
}

p {
    margin-bottom: 8dp;
}

em {
    font-style: italic;
    color: $quiet;
}

strong {
    font-weight: bold;
    color: $softred;
}

#buttons {
    margin-bottom: 8dp;
}

.btn {
    display: inline-block;
    padding: 5dp 14dp;
    margin-right: 6dp;
    background-color: $raised;
    border: 1dp $gold;
    border-radius: 3dp;
    color: $light;
}

.btn:hover {
    background-color: $rule;
    color: $light;
}

.btn:active {
    background-color: $ink;
}

.btn.danger:hover {
    background-color: $red;
}

#status {
    color: $quiet;
    font-size: 13dp;
}

#list {
    height: 220dp;
    overflow-y: scroll;
    background-color: $ink;
    border: 1dp $rule;
    padding: 4dp;
}

.row {
    padding: 2dp 4dp;
    height: 20dp;
}

.row:hover {
    background-color: $raised;
}

.row.odd {
    background-color: $ink;
}

/* Scrollbars are unstyled by default in RmlUi. */
scrollbarvertical {
    width: 14dp;
}

scrollbarvertical slidertrack {
    background-color: $ink;
}

scrollbarvertical sliderbar {
    width: 14dp;
    min-height: 24dp;
    background-color: $rule;
    border-radius: 6dp;
}

scrollbarvertical sliderbar:hover {
    background-color: $green;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}
