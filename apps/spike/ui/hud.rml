<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="components.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<body data-model="hud">

<div id="topbar">
    <div id="topbar-rule"></div>
    <svg id="logo-icon" data-attr-src="logo_icon"/>
    <div id="logo">{{ t.logo }}</div>
    <div id="house">{{ t.house }}</div>
    <div class="vdiv" id="divider-house"></div>
    <div id="resources">
        <div class="res" data-for="r : resources" data-attr-id="'res-' + r.key" data-attr-title="r.tooltip">
            <svg data-attr-src="r.icon"/>
            <div class="res-label">{{ r.label }}</div>
            <div class="res-value">{{ r.value }}</div>
            <div class="res-note" data-class-pos="r.tone == 'pos'" data-class-neg="r.tone == 'neg'">{{ r.note }}</div>
        </div>
    </div>
    <div class="vdiv" id="divider-date"></div>
</div>

<div id="nav">
    <div id="nav-list">
        <div class="nav-item" data-for="n : nav" data-attr-id="'nav-' + n.key" data-class-active="active == n.key"
             data-class-is-disabled="!n.available" data-attr-title="n.hint" data-event-click="nav(n.key)">
            <div class="nav-mark"></div>
            <svg data-attr-src="n.icon"/>
            <div class="nav-label">{{ n.name }}</div>
        </div>
    </div>
    <div class="nav-item nav-system" id="nav-system" data-class-active="active == 'system'"
         data-class-is-disabled="!system.available" data-attr-title="system.name" data-event-click="nav('system')">
        <div class="nav-mark"></div>
        <svg data-attr-src="system.icon"/>
    </div>
</div>

<div id="statusbar">
    <div id="map-title">{{ t.map_title }}</div>
    <div id="modes">
        <div class="mode" data-for="m : modes" data-attr-id="'mode-' + m.key" data-class-active="mode == m.key"
             data-class-is-disabled="!m.available" data-attr-title="m.hint" data-event-click="mode(m.key)">{{ m.name }}</div>
    </div>
    <div id="hints">{{ t.hints }}</div>
</div>

</body>
</rml>
