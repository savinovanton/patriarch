/* Character window in the theme "Rodovaya kantselyariya": dollar-prefixed tokens come from data/ui/theme.pd (pat::ui::expand_tokens),
   the shared rules from the generated theme.rcss linked by the document (docs/dev/ui-design.md). */

h1, h2, p {
    display: block;
}

body {
    pointer-events: none;
}

#window {
    pointer-events: auto;
    position: absolute;
    right: 306dp;
    top: 117dp;
    width: 460dp;
    padding: 14dp 16dp;
    background-color: $panel_a95;
    border: 1dp $rule;
    border-radius: 2dp;
}

#header {
    height: 64dp;
    margin-bottom: 10dp;
}

#portrait {
    float: left;
    width: 56dp;
    height: 56dp;
    margin-right: 14dp;
    background-color: $raised;
    border: 2dp $gold;
    border-radius: 28dp;
}

.initials {
    font-family: "PT Serif";
    font-size: 24dp;
    font-weight: bold;
    color: $light;
    text-align: center;
    line-height: 52dp;
}

h1 {
    font-family: "PT Serif";
    font-size: 22dp;
    font-weight: bold;
    color: $light;
    margin-bottom: 2dp;
}

h2 {
    font-family: "PT Serif";
    font-size: 14dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
    color: $quiet;
    margin: 10dp 0 5dp 0;
}

.sub {
    color: $quiet;
    font-size: 13dp;
}

#tabs {
    margin-bottom: 8dp;
    border-bottom: 1dp $rule;
}

.tab {
    display: inline-block;
    padding: 5dp 12dp 6dp 12dp;
    margin-right: 6dp;
    color: $quiet;
    font-size: 13dp;
}

.tab:hover {
    color: $light;
}

.tab.active {
    color: $light;
    border-bottom: 2dp $gold;
}

.skill {
    height: 22dp;
    margin-bottom: 3dp;
}

.skill:hover {
    background-color: $light_a8;
}

.skill-name {
    display: inline-block;
    width: 130dp;
}

.bar {
    display: inline-block;
    width: 220dp;
    height: 8dp;
    margin-top: 6dp;
    background-color: $ink;
    border: 1dp $rule;
    border-radius: 2dp;
}

.fill {
    height: 8dp;
    background-color: $gold;
    border-radius: 1dp;
}

.skill-value {
    display: inline-block;
    width: 30dp;
    margin-left: 8dp;
    color: $light;
}

.trait {
    display: inline-block;
    padding: 2dp 9dp;
    margin: 0 4dp 4dp 0;
    background-color: $raised;
    border: 1dp $rule;
    border-radius: 9dp;
    font-size: 13dp;
}

.btn {
    display: inline-block;
    padding: 5dp 12dp;
    margin: 0 6dp 6dp 0;
    background-color: $raised;
    border: 1dp $gold;
    border-radius: 2dp;
    color: $light;
    font-size: 13dp;
}

.btn:hover {
    background-color: $rule;
    color: $light;
}

.btn:active {
    background-color: $panel;
}

.line {
    margin-bottom: 4dp;
}

#rel_list {
    height: 280dp;
    overflow-y: scroll;
    background-color: $ink;
    border: 1dp $rule;
}

.pad {
    width: 100%;
}

.row {
    box-sizing: border-box;
    height: 24dp;
    line-height: 24dp;
    padding: 0 8dp;
    font-size: 13dp;
}

.row:hover {
    background-color: $light_a8;
}

#statusbar {
    margin-top: 8dp;
    color: $quiet;
    font-size: 12dp;
    height: 18dp;
}

scrollbarvertical {
    width: 12dp;
}

scrollbarvertical slidertrack {
    background-color: $ink;
}

scrollbarvertical sliderbar {
    width: 12dp;
    min-height: 24dp;
    background-color: $rule;
    border-radius: 2dp;
}

scrollbarvertical sliderbar:hover {
    background-color: $quiet;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}
