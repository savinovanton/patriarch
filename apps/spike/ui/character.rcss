/* Character window in the Olive Stone theme (tokens in olive.rcss and docs/dev/ui-design.md).
   Reload-friendly: olive.rcss is linked by the document; the block-level rules live there. */

h1, h2, p {
    display: block;
}

body {
    pointer-events: none;
}

#window {
    pointer-events: auto;
    position: absolute;
    right: 306dp;
    top: 117dp;
    width: 460dp;
    padding: 14dp 16dp;
    background-color: #282f26f2;
    border: 1dp #626d50;
    border-radius: 2dp;
}

#header {
    height: 64dp;
    margin-bottom: 10dp;
}

#portrait {
    float: left;
    width: 56dp;
    height: 56dp;
    margin-right: 14dp;
    background-color: #3d4736;
    border: 2dp #c8af77;
    border-radius: 28dp;
}

.initials {
    font-family: "Times New Roman";
    font-size: 24dp;
    font-weight: bold;
    color: #eee8d8;
    text-align: center;
    line-height: 52dp;
}

h1 {
    font-family: "Times New Roman";
    font-size: 22dp;
    font-weight: bold;
    color: #eee8d8;
    margin-bottom: 2dp;
}

h2 {
    font-family: "Times New Roman";
    font-size: 14dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
    color: #a0ad8b;
    margin: 10dp 0 5dp 0;
}

.sub {
    color: #a0ad8b;
    font-size: 13dp;
}

#tabs {
    margin-bottom: 8dp;
    border-bottom: 1dp #626d50;
}

.tab {
    display: inline-block;
    padding: 5dp 12dp 6dp 12dp;
    margin-right: 6dp;
    color: #a0ad8b;
    font-size: 13dp;
}

.tab:hover {
    color: #eee8d8;
}

.tab.active {
    color: #eee8d8;
    border-bottom: 2dp #c8af77;
}

.skill {
    height: 22dp;
    margin-bottom: 3dp;
}

.skill:hover {
    background-color: #ffffff12;
}

.skill-name {
    display: inline-block;
    width: 130dp;
}

.bar {
    display: inline-block;
    width: 220dp;
    height: 8dp;
    margin-top: 6dp;
    background-color: #1c211b;
    border: 1dp #626d50;
    border-radius: 2dp;
}

.fill {
    height: 8dp;
    background-color: #c8af77;
    border-radius: 1dp;
}

.skill-value {
    display: inline-block;
    width: 30dp;
    margin-left: 8dp;
    color: #eee8d8;
}

.trait {
    display: inline-block;
    padding: 2dp 9dp;
    margin: 0 4dp 4dp 0;
    background-color: #3d4736;
    border: 1dp #626d50;
    border-radius: 9dp;
    font-size: 13dp;
}

.btn {
    display: inline-block;
    padding: 5dp 12dp;
    margin: 0 6dp 6dp 0;
    background-color: #3d4736;
    border: 1dp #c8af77;
    border-radius: 2dp;
    color: #eee8d8;
    font-size: 13dp;
}

.btn:hover {
    background-color: #4d5a44;
    color: #ffffff;
}

.btn:active {
    background-color: #2f3829;
}

.line {
    margin-bottom: 4dp;
}

#rel_list {
    height: 280dp;
    overflow-y: scroll;
    background-color: #1c211b;
    border: 1dp #626d50;
}

.pad {
    width: 100%;
}

.row {
    box-sizing: border-box;
    height: 24dp;
    line-height: 24dp;
    padding: 0 8dp;
    font-size: 13dp;
}

.row:hover {
    background-color: #ffffff14;
}

#statusbar {
    margin-top: 8dp;
    color: #a0ad8b;
    font-size: 12dp;
    height: 18dp;
}

scrollbarvertical {
    width: 12dp;
}

scrollbarvertical slidertrack {
    background-color: #1c211b;
}

scrollbarvertical sliderbar {
    width: 12dp;
    min-height: 24dp;
    background-color: #626d50;
    border-radius: 2dp;
}

scrollbarvertical sliderbar:hover {
    background-color: #7d8a66;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}
