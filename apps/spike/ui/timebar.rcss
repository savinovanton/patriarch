/* Date and speed controls, top right (Olive Stone, see olive.rcss for the tokens). */
#bar {
    position: absolute;
    right: 28dp;
    top: 28dp;
    width: 282dp;
    height: 57dp;
    padding: 6dp 12dp;
    background-color: #282f26;
    border: 1dp #626d50;
    border-radius: 2dp;
}

#date {
    display: block;
    font-family: "Times New Roman";
    font-size: 17dp;
    font-weight: bold;
    color: #eee8d8;
    margin-bottom: 5dp;
}

.spd {
    display: inline-block;
    min-width: 26dp;
    height: 22dp;
    margin-right: 4dp;
    padding: 0 4dp;
    background-color: #3d4736;
    border: 1dp #626d50;
    border-radius: 2dp;
    font-size: 12dp;
    line-height: 20dp;
    text-align: center;
    color: #c5c7b5;
}

.spd:hover {
    background-color: #4d5a44;
    color: #eee8d8;
}

.spd.active {
    background-color: #7b6a3f;
    border-color: #c8af77;
    color: #ffffff;
}
