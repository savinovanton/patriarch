/* Date and speed controls, top right (dollar-prefixed tokens of data/ui/theme.pd). */
#bar {
    pointer-events: auto;
    position: absolute;
    right: 28dp;
    top: 28dp;
    width: 282dp;
    height: 57dp;
    padding: 6dp 12dp;
    background-color: $panel;
    border: 1dp $rule;
    border-radius: 2dp;
}

#date {
    display: block;
    font-family: "PT Serif";
    font-size: 17dp;
    font-weight: bold;
    color: $light;
    margin-bottom: 5dp;
}

.spd {
    display: inline-block;
    min-width: 26dp;
    height: 22dp;
    margin-right: 4dp;
    padding: 0 4dp;
    background-color: $raised;
    border: 1dp $rule;
    border-radius: 2dp;
    font-size: 12dp;
    line-height: 20dp;
    text-align: center;
    color: $quiet;
}

.spd:hover {
    background-color: $rule;
    color: $light;
}

.spd.active {
    background-color: $green;
    border-color: $gold;
    color: $light;
}
