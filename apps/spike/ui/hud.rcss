/* Frame of the map screen: top bar, left navigation, bottom bar (UI-D04; board 01 of the mockup, geometry in
   data/ui/layout/board_01_map_province.pd at 1920x1080: 1dp = 1 design pixel, the application scales dp).
   The bars stretch with the window, the navigation keeps its width and the bottom bar its height. */

/* ---- top bar: 96dp of ink with a 2dp gold rule at its bottom edge */
#topbar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 96dp;
    background-color: $ink;
    pointer-events: auto;
}

#topbar-rule {
    position: absolute;
    left: 0;
    top: 94dp;
    width: 100%;
    height: $rule_panel;
    background-color: $gold;
}

#logo-icon {
    position: absolute;
    left: 24dp;
    top: 16dp;
    width: 42dp;
    height: 48dp;
}

#logo {
    position: absolute;
    left: 100dp;
    top: 13dp;
    font-family: $serif;
    font-size: $type_28;
    color: $light;
}

#house {
    position: absolute;
    left: 102dp;
    top: 54dp;
    font-size: $type_13;
    font-weight: bold;
    letter-spacing: 2dp;
    color: $gold;
    white-space: nowrap;
}

.vdiv {
    position: absolute;
    top: 20dp;
    width: $stroke_hairline;
    height: 56dp;
    background-color: $rule;
}

#divider-house {
    left: 358dp;
}

#divider-date {
    left: 1260dp;
}

/* resources: five blocks 174dp apart, the first icon at x = 386 */
#resources {
    position: absolute;
    left: 386dp;
    top: 0;
    height: 96dp;
    display: flex;
    flex-direction: row;
}

.res {
    position: relative;
    width: 174dp;
    height: 96dp;
}

.res svg {
    position: absolute;
    left: 0;
    top: 21dp;
    width: $icon_size;
    height: $icon_size;
}

.res-label {
    position: absolute;
    left: 35dp;
    top: 15dp;
    font-size: $type_13;
    color: $quiet;
}

.res-value {
    position: absolute;
    left: 35dp;
    top: 34dp;
    font-family: $serif;
    font-size: $type_25;
    color: $light;
    white-space: nowrap;
}

.res-note {
    position: absolute;
    left: 35dp;
    top: 67dp;
    font-size: $type_12;
    color: $quiet;
    white-space: nowrap;
}

.res-note.pos {
    color: $success;
}

.res-note.neg {
    color: $softred;
}

/* ---- left navigation: 96dp wide, nine entries of 80x78 with a 10dp gap, settings at the bottom */
#nav {
    position: absolute;
    left: 0;
    top: 96dp;
    bottom: 44dp;
    width: 96dp;
    background-color: $ink;
    pointer-events: auto;
}

#nav-list {
    position: absolute;
    left: 8dp;
    top: 24dp;
    width: 80dp;
}

.nav-item {
    position: relative;
    box-sizing: border-box;
    width: 80dp;
    height: 78dp;
    margin-bottom: 10dp;
    border: $focus_ring transparent;
    border-radius: $radius;
    pointer-events: auto;
    tab-index: auto;
    cursor: pointer;
}

.nav-item svg {
    position: absolute;
    left: 25dp;
    top: 10dp;
    width: $icon_size;
    height: $icon_size;
}

.nav-label {
    position: absolute;
    left: 0;
    top: 46dp;
    width: 76dp;
    font-size: $type_12;
    text-align: center;
    color: $quiet;
    white-space: nowrap;
}

.nav-mark {
    display: none;
    position: absolute;
    left: -2dp;
    top: 8dp;
    width: 3dp;
    height: 54dp;
    background-color: $gold;
}

.nav-item:hover {
    background-color: $raised;
}

.nav-item.active {
    background-color: $raised;
}

.nav-item.active .nav-mark {
    display: block;
}

.nav-item.active .nav-label {
    color: $light;
}

/* an entry without a screen: dimmed, shows its hint, no hover and no tab stop (tab-index comes from is-disabled) */
.nav-item.is-disabled {
    opacity: 0.45;
    cursor: default;
    tab-index: none;
}

.nav-item.is-disabled:hover {
    background-color: transparent;
}

.nav-system {
    position: absolute;
    left: 8dp;
    bottom: 18dp;
    height: 60dp;
    margin-bottom: 0;
}

.nav-system svg {
    left: 26dp;
}

.kbd .nav-item:focus {
    border-color: $gold;
}

/* ---- bottom bar: 44dp of ink */
#statusbar {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 44dp;
    background-color: $ink;
    pointer-events: auto;
}

#map-title {
    position: absolute;
    left: 120dp;
    top: 12dp;
    font-size: $type_14;
    font-weight: bold;
    color: $gold;
    white-space: nowrap;
}

#modes {
    position: absolute;
    left: 344dp;
    top: 0;
    height: 44dp;
    white-space: nowrap;
}

.mode {
    display: inline-block;
    box-sizing: border-box;
    height: 44dp;
    margin-right: 28dp;
    padding-top: 12dp;
    border-bottom: $focus_ring transparent;
    font-size: $type_14;
    color: $quiet;
    pointer-events: auto;
    tab-index: auto;
    cursor: pointer;
}

.mode:hover {
    color: $light;
}

.mode.active {
    color: $light;
    border-bottom-color: $gold;
}

.mode.is-disabled {
    opacity: 0.45;
    cursor: default;
    tab-index: none;
}

.kbd .mode:focus {
    border-bottom-color: $gold;
}

#hints {
    position: absolute;
    right: 40dp;
    top: 13dp;
    font-size: $type_13;
    color: $quiet;
    white-space: nowrap;
}
