/* Heads-up display layout (positions measured on the Figma frame 1920x1080; marked [check] in docs). */

#frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

/* ---- realm plaque (top left) */
#realm {
    position: absolute;
    left: 25dp;
    top: 20dp;
    width: 234dp;
    height: 65dp;
}

#realm svg {
    position: absolute;
    left: 12dp;
    top: 13dp;
    width: 40dp;
    height: 38dp;
}

#realm-name {
    position: absolute;
    left: 64dp;
    top: 12dp;
    font-size: 15dp;
    text-transform: uppercase;
}

#realm-sub {
    position: absolute;
    left: 64dp;
    top: 34dp;
    font-size: 12dp;
}

/* ---- resource strip */
#strip {
    position: absolute;
    left: 277dp;
    top: 28dp;
    height: 56dp;
    white-space: nowrap;
}

.res {
    display: inline-block;
    position: relative;
    width: 142dp;
    height: 54dp;
    margin-right: 8dp;
    vertical-align: top;
}

.res svg {
    position: absolute;
    left: 10dp;
    top: 17dp;
    width: 20dp;
    height: 20dp;
}

.res-label {
    position: absolute;
    left: 40dp;
    top: 9dp;
    font-size: 11dp;
}

.res-value {
    position: absolute;
    left: 40dp;
    top: 24dp;
    font-size: 17dp;
    font-weight: bold;
}

.res-delta {
    position: absolute;
    right: 10dp;
    top: 29dp;
    font-size: 11dp;
    color: $quiet;
}

.res-delta.neg {
    color: $softred;
}

/* ---- alert badges */
#alerts {
    position: absolute;
    left: 1057dp;
    top: 34dp;
    white-space: nowrap;
}

.alert {
    pointer-events: auto;
    display: inline-block;
    position: relative;
    width: 38dp;
    height: 38dp;
    margin-right: 6dp;
}

.alert svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 38dp;
    height: 38dp;
}

.badge {
    position: absolute;
    right: -4dp;
    top: -5dp;
    min-width: 14dp;
    height: 14dp;
    padding: 0 3dp;
    border-radius: 7dp;
    background-color: $gold;
    color: $panel;
    font-size: 10dp;
    font-weight: bold;
    line-height: 14dp;
    text-align: center;
}

/* ---- left menu */
#menu {
    position: absolute;
    left: 33dp;
    top: 235dp;
    width: 40dp;
}

.menu-btn {
    pointer-events: auto;
    display: block;
    position: relative;
    width: 40dp;
    height: 38dp;
    margin-bottom: 8dp;
}

.menu-btn svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 40dp;
    height: 38dp;
}

.menu-btn .ov {
    position: absolute;
    left: 0;
    top: 0;
    width: 40dp;
    height: 38dp;
    border-radius: 2dp;
}

.menu-btn:hover .ov {
    background-color: $light_a10;
}

.menu-btn.active .ov {
    background-color: $gold_a22;
    border: 1dp $light;
}

/* ---- right column: holdings, armies, state affairs */
#right {
    position: absolute;
    right: 28dp;
    top: 117dp;
    width: 258dp;
}

.box {
    padding: 10dp 12dp 8dp 12dp;
}

.box-title {
    position: relative;
    height: 20dp;
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 1dp;
}

.box-title .count {
    position: absolute;
    right: 0;
    top: 0;
    color: $light;
}

#tabs {
    height: 24dp;
    margin-bottom: 6dp;
    border-bottom: 1dp $rule;
    white-space: nowrap;
}

.tab {
    display: inline-block;
    height: 23dp;
    margin-right: 14dp;
    font-size: 12dp;
    line-height: 20dp;
    color: $quiet;
}

.tab:hover {
    color: $light;
}

.tab.active {
    color: $light;
    border-bottom: 2dp $gold;
}

.row {
    position: relative;
    height: 26dp;
    font-size: 13dp;
}

.row svg {
    position: absolute;
    left: 0;
    top: 2dp;
    width: 24dp;
    height: 23dp;
}

.row-name {
    position: absolute;
    left: 34dp;
    top: 5dp;
}

.row-value {
    position: absolute;
    right: 0;
    top: 5dp;
}

.army-title {
    margin-top: 10dp;
}

#affairs-title {
    display: inline-block;
    padding: 2dp 8dp;
    background-color: $panel_a80;
    border-radius: 2dp;
    margin: 16dp 0 8dp 0;
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 1dp;
}

.affair {
    position: relative;
    height: 54dp;
    margin-bottom: 8dp;
}

.affair svg {
    position: absolute;
    left: 10dp;
    top: 8dp;
    width: 36dp;
    height: 36dp;
}

.affair-title {
    position: absolute;
    left: 58dp;
    top: 10dp;
    font-size: 13dp;
    font-weight: bold;
}

.affair-sub {
    position: absolute;
    left: 58dp;
    top: 30dp;
    font-size: 11dp;
}

/* ---- chronicle (bottom left) */
#chronicle {
    position: absolute;
    left: 75dp;
    bottom: 75dp;
    width: 329dp;
}

.line {
    height: 18dp;
    font-size: 12dp;
    white-space: nowrap;
}

.time {
    display: inline-block;
    width: 44dp;
}
