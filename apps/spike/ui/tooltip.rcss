/* Tooltip documents are generated by pat::ui::TooltipManager (see explanation.cpp for the markup).
   Colours are tokens of data/ui/theme.pd (dollar-prefixed names, pat::ui::expand_tokens). */
h1, h2, p, div {
    display: block;
}

/* The tooltip document body must not cover the UI below it (it would swallow hover). */
body {
    width: 0;
    height: 0;
    margin: 0;
    font-family: "PT Sans Caption";
    font-size: 14dp;
    color: $light;
}

.tip {
    position: absolute;
    left: 0;
    top: 0;
    width: 280dp;
    padding: 8dp 10dp;
    background-color: $ink_a95;
    border: 1dp $gold;
    border-radius: 2dp;
}

.tip-head {
    margin-bottom: 6dp;
    padding-bottom: 4dp;
    border-bottom: 1dp $rule;
}

.tip-title {
    font-family: "PT Serif";
    font-size: 16dp;
    font-weight: bold;
    color: $light;
}

.tip-total {
    float: right;
    font-weight: bold;
    color: $light;
}

.tip-row {
    height: 20dp;
    padding: 0 4dp;
}

.tip-row.nested {
    background-color: $light_a6;
}

.tip-row.nested:hover {
    background-color: $light_a13;
}

.tip-label {
    display: inline-block;
}

.tip-row.nested .tip-label {
    text-decoration: underline;
}

.tip-value {
    float: right;
    color: $light;
}

.tip-value.pos {
    color: $success;
}

.tip-value.neg {
    color: $softred;
}

.tip-note {
    margin-top: 6dp;
    color: $quiet;
    font-size: 12dp;
}
