/* Tooltip documents are generated by pat::ui::TooltipManager (see explanation.cpp for the markup). */
h1, h2, p, div {
    display: block;
}

/* The tooltip document body must not cover the UI below it (it would swallow hover). */
body {
    width: 0;
    height: 0;
    margin: 0;
    font-family: Arial;
    font-size: 14dp;
    color: #e8e0cc;
}

.tip {
    position: absolute;
    left: 0;
    top: 0;
    width: 280dp;
    padding: 8dp 10dp;
    background-color: #14100af2;
    border: 1dp #a08a54;
    border-radius: 3dp;
}

.tip-head {
    margin-bottom: 6dp;
    padding-bottom: 4dp;
    border-bottom: 1dp #4a4030;
}

.tip-title {
    font-family: "Times New Roman";
    font-size: 16dp;
    font-weight: bold;
    color: #f2d98a;
}

.tip-total {
    float: right;
    font-weight: bold;
    color: #ffffff;
}

.tip-row {
    height: 20dp;
    padding: 0 4dp;
}

.tip-row.nested {
    background-color: #1f1a10;
}

.tip-row.nested:hover {
    background-color: #3a3322;
}

.tip-label {
    display: inline-block;
}

.tip-row.nested .tip-label {
    text-decoration: underline;
}

.tip-value {
    float: right;
    color: #e8e0cc;
}

.tip-value.pos {
    color: #8fd48a;
}

.tip-value.neg {
    color: #e88a7a;
}

.tip-note {
    margin-top: 6dp;
    color: #b8b090;
    font-size: 12dp;
}
