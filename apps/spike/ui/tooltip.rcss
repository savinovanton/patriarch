/* Tooltip documents are generated by pat::ui::TooltipManager (see explanation.cpp for the markup).
   Olive Stone colours: panel #282f26, stroke #626d50, gold #c8af77, text #eee8d8, muted #a0ad8b. */
h1, h2, p, div {
    display: block;
}

/* The tooltip document body must not cover the UI below it (it would swallow hover). */
body {
    width: 0;
    height: 0;
    margin: 0;
    font-family: Arial;
    font-size: 14dp;
    color: #eee8d8;
}

.tip {
    position: absolute;
    left: 0;
    top: 0;
    width: 280dp;
    padding: 8dp 10dp;
    background-color: #1f251ef5;
    border: 1dp #c8af77;
    border-radius: 2dp;
}

.tip-head {
    margin-bottom: 6dp;
    padding-bottom: 4dp;
    border-bottom: 1dp #626d50;
}

.tip-title {
    font-family: "Times New Roman";
    font-size: 16dp;
    font-weight: bold;
    color: #eee8d8;
}

.tip-total {
    float: right;
    font-weight: bold;
    color: #ffffff;
}

.tip-row {
    height: 20dp;
    padding: 0 4dp;
}

.tip-row.nested {
    background-color: #ffffff0f;
}

.tip-row.nested:hover {
    background-color: #ffffff22;
}

.tip-label {
    display: inline-block;
}

.tip-row.nested .tip-label {
    text-decoration: underline;
}

.tip-value {
    float: right;
    color: #eee8d8;
}

.tip-value.pos {
    color: #9fd38a;
}

.tip-value.neg {
    color: #e08a7a;
}

.tip-note {
    margin-top: 6dp;
    color: #a0ad8b;
    font-size: 12dp;
}
