/* Tooltips (UI-D03): the dark panel with a gold hairline of the tooltip boards. The markup comes from
   pat::ui::render_tooltip_rml (explanation.cpp); the same classes style the static samples of the component
   gallery. Colours, type sizes and sizes are tokens of data/ui/theme.pd (dollar-prefixed names). */
h1, h2, p, div {
    display: block;
}

/* The tooltip document body must not cover the UI below it (it would swallow hover). */
body.tip-doc {
    width: 0;
    height: 0;
    margin: 0;
    font-family: $sans;
    font-size: $type_14;
    color: $light;
}

.tip {
    position: relative;
    box-sizing: border-box;
    width: $tip_w;
    padding: 18dp $tip_pad 20dp $tip_pad;
    background-color: $panel;
    border: $stroke_hairline $gold;
    border-radius: $radius;
    font-family: $sans;
    font-size: $type_14;
    color: $light;
}

.tip.tip-wide {
    width: $tip_w_wide;
}

.tip.tip-float {
    position: absolute;
    left: 0;
    top: 0;
}

.tip-close {
    display: none;
    position: absolute;
    right: $space_8;
    top: $space_8;
    width: $tip_close;
    height: $tip_close;
    border-radius: $radius;
}

.tip.pinned .tip-close {
    display: block;
}

.tip-close:hover {
    background-color: $raised;
}

.tip-close svg {
    width: 16dp;
    height: 16dp;
    margin: 5dp;
}

.tip-head {
    padding-right: $tip_close;
}

.tip-title {
    font-family: $serif;
    font-size: $type_22;
    color: $light;
}

.tip.tip-wide .tip-title {
    font-size: $type_24;
}

.tip-title.warn {
    color: $softred;
}

.tip-total {
    float: right;
    font-weight: bold;
    color: $light;
}

.tip-note {
    margin-top: 6dp;
    color: $quiet;
    font-size: $type_14;
}

.tip-headline {
    margin-top: 4dp;
    font-family: $serif;
    font-size: $type_32;
    color: $gold;
}

.tip-line {
    margin-top: 12dp;
    color: $quiet;
    font-size: $type_17;
}

.tip-rule {
    height: 1dp;
    margin: 16dp 0 12dp 0;
    background-color: $rule;
}

.tip-row {
    height: 28dp;
    font-size: $type_16;
}

.tip-row.nested {
    background-color: $light_a6;
}

.tip-row.nested:hover {
    background-color: $light_a13;
}

.tip-label {
    display: inline-block;
    color: $quiet;
}

.tip-row.nested .tip-label {
    text-decoration: underline;
}

.tip-factor {
    display: inline-block;
    margin-left: 8dp;
    color: $quiet;
    font-size: $type_13;
}

.tip-value {
    float: right;
    font-weight: bold;
    color: $light;
}

.tip-value.pos {
    color: $success;
}

.tip-value.neg {
    color: $softred;
}

.tip-sum {
    height: 32dp;
    margin-top: 2dp;
}

.tip-sum-label {
    display: inline-block;
    font-family: $serif;
    font-size: $type_20;
    color: $light;
}

.tip-sum-value {
    float: right;
    font-family: $serif;
    font-size: $type_22;
    color: $gold;
}

.tip-sum-value.pos {
    color: $success;
}

.tip-sum-value.neg {
    color: $softred;
}

.tip-footer {
    margin-top: 14dp;
    color: $gold;
    font-size: $type_13;
}
