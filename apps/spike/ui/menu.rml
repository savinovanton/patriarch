<rml>
<head>
    <title>Menu</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="components.rcss"/>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<!-- Start menu (UI-D12, boards "МЕНЮ / ..."): one full-screen document that shows the current screen of the
     MenuNavigator. Fixed captions are `{{ rev | tr('key') }}`: `tr` reads the string table, `rev` changes when the
     language does (it only makes the expression depend on something). -->
<body data-model="menu">
<div id="menu">

    <div id="menu-paper" data-if="screen == 'overview'"></div>
    <div id="menu-art" data-if="screen != 'overview'" data-style-decorator="art_deco"></div>
    <div id="menu-shade" data-if="screen != 'overview'" data-class-dim="screen != 'main'" data-class-world="screen == 'world'" data-class-ready="wv.ready"></div>
    <div id="menu-contrast" data-if="screen == 'main'"></div>
    <div id="menu-contrast-left" data-if="screen == 'main'"></div>

    <div id="stage" data-class-blocked="dialog != ''">

        <div id="menu-copyright" data-class-overview="screen == 'overview'">{{ rev | tr('ui.menu.copyright') }}</div>
        <div id="menu-region" data-class-overview="screen == 'overview'">{{ rev | tr('ui.menu.region') }}</div>

        <!-- ================= main menu (boards 01 and 02) ================= -->
        <div id="screen-main" class="screen" data-if="screen == 'main'">
            <svg id="menu-shield" data-attr-src="icons + '/shield@gold.svg'"/>
            <div id="menu-title">{{ rev | tr('ui.menu.brand') }}</div>
            <div id="menu-tagline">{{ rev | tr('ui.menu.main.tagline') }}</div>
            <div id="menu-title-rule"><svg data-attr-src="decor + '/engraved_title_rule@gold.svg'"/></div>
            <div id="menu-lead">{{ lead }}</div>
            <div id="menu-hint" data-if="show_hint">{{ rev | tr('ui.menu.main.hint.line1') }}<br/>{{ rev | tr('ui.menu.main.hint.line2') }}</div>

            <button class="mi" data-for="it : items" data-attr-id="'mi-' + it.id"
                    data-style-top="it.top" data-style-height="it.height"
                    data-class-primary="it.primary" data-class-selected="sel == it.index"
                    data-class-is-disabled="!it.enabled"
                    data-event-click="item(it.id)" data-event-mouseover="hover(it.index)" data-event-focus="hover(it.index)">
                <div class="mi-edge"></div>
                <div class="mi-text">{{ it.label }}</div>
                <svg class="mi-chevron" data-attr-src="icons + '/chevron@ink.svg'"/>
                <div class="mi-note" data-if="it.note != ''" data-class-note-save="it.note_save" data-style-top="it.note_top">{{ it.note }}</div>
            </button>

            <div id="menu-lang">
                <svg data-attr-src="icons + '/globe@light.svg'"/>
                <div id="menu-lang-text">{{ rev | tr('ui.menu.lang') }}</div>
            </div>
        </div>

        <!-- ================= header of every screen but the main menu and the overview ================= -->
        <div id="screen-head" class="screen" data-if="screen != 'main' &amp;&amp; screen != 'overview'">
            <svg id="page-shield" data-attr-src="icons + '/shield@gold.svg'"/>
            <div id="page-brand">{{ rev | tr('ui.menu.brand') }}</div>
            <div id="page-caption">{{ page_caption }}</div>
        </div>

        <!-- ================= page frame of the load, about, new game, own house and goal screens ================= -->
        <div id="screen-page" class="screen" data-if="paged">
            <div id="panel"></div>
            <div id="panel-rule"></div>
            <div id="page-eyebrow">{{ rev | tr('ui.menu.eyebrow') }}</div>
            <div id="page-title">{{ page_title }}</div>
            <div id="page-subtitle">{{ page_subtitle }}</div>
            <div class="page-divider" id="page-divider-top"></div>
            <div class="page-divider" id="page-divider-bottom"></div>
            <button id="btn-main" class="btn" data-event-click="back()"><span class="btn-text">{{ back_label }}</span></button>
        </div>

        <!-- ================= load (boards 07, 08) ================= -->
        <div id="screen-load" class="screen" data-if="screen == 'load'">
            <div id="save-list" data-if="has_saves">
                <button class="save" data-for="s : saves" data-attr-id="'save-' + s.index"
                        data-class-selected="sel_save == s.index" data-class-bad="!s.ok"
                        data-event-click="pick(s.index)" data-event-dblclick="open_save(s.index)"
                        data-event-focus="pick(s.index)">
                    <div class="save-frame"></div>
                    <svg class="save-icon" data-attr-src="s.icon"/>
                    <div class="save-name">{{ s.name }}</div>
                    <div class="save-badge" data-class-bad="!s.ok">{{ s.badge }}</div>
                    <div class="save-line">{{ s.line1 }}</div>
                    <div class="save-sub" data-class-bad="!s.ok">{{ s.line2 }}</div>
                </button>
            </div>
            <div id="save-summary" data-if="has_saves &amp;&amp; has_sel">
                <div id="save-preview" data-style-decorator="preview_deco"></div>
                <div id="save-house">{{ sum.house }}</div>
                <div id="save-date">{{ sum.date }}</div>
                <div class="page-divider" id="save-divider"></div>
                <div id="save-keys">
                    <div>{{ rev | tr('ui.menu.load.summary.head') }}</div>
                    <div>{{ rev | tr('ui.menu.load.summary.kind') }}</div>
                    <div>{{ rev | tr('ui.menu.load.summary.treasury') }}</div>
                </div>
                <div id="save-values">
                    <div>{{ sum.head }}</div>
                    <div>{{ sum.kind }}</div>
                    <div>{{ sum.treasury }}</div>
                </div>
            </div>
            <button id="btn-load" class="btn btn-primary" data-if="has_saves" data-event-click="load()">
                <svg data-attr-src="icons + '/play@gold.svg'"/><span class="btn-text">{{ rev | tr('ui.menu.load.button') }}</span></button>

            <div id="load-empty" data-if="!has_saves">
                <svg id="load-empty-icon" data-attr-src="icons + '/scroll@muted.svg'"/>
                <div id="load-empty-title">{{ rev | tr('ui.menu.load.empty.title') }}</div>
                <div id="load-empty-text">{{ rev | tr('ui.menu.load.empty.line1') }}<br/>{{ rev | tr('ui.menu.load.empty.line2') }}</div>
                <button id="btn-new" class="btn btn-primary" data-event-click="item('new')">
                    <svg data-attr-src="icons + '/quill@gold.svg'"/><span class="btn-text">{{ rev | tr('ui.menu.item.new') }}</span></button>
            </div>
        </div>

        <!-- ================= about ================= -->
        <div id="screen-about" class="screen" data-if="screen == 'about'">
            <div id="about-story">
                <div id="about-story-title">{{ rev | tr('ui.menu.about.story.title') }}</div>
                <div id="about-story-text">{{ rev | tr('ui.menu.about.story.line1') }}<br/>{{ rev | tr('ui.menu.about.story.line2') }}<br/>{{ rev | tr('ui.menu.about.story.line3') }}<br/>{{ rev | tr('ui.menu.about.story.line4') }}</div>
                <div class="page-divider" id="about-divider"></div>
                <div class="about-key" id="about-key-era">{{ rev | tr('ui.menu.about.era') }}</div>
                <div class="about-value" id="about-value-era">{{ rev | tr('ui.menu.about.era.value') }}</div>
                <div class="about-key" id="about-key-mode">{{ rev | tr('ui.menu.about.mode') }}</div>
                <div class="about-value" id="about-value-mode">{{ rev | tr('ui.menu.about.mode.value') }}</div>
                <div class="about-key" id="about-key-people">{{ rev | tr('ui.menu.about.people') }}</div>
                <div class="about-value" id="about-value-people">{{ rev | tr('ui.menu.about.people.value') }}</div>
            </div>
            <div id="about-credits">
                <div id="about-credits-caption">{{ rev | tr('ui.menu.about.credits.caption') }}</div>
                <div class="credit-key" id="credit-key-author">{{ rev | tr('ui.menu.about.author') }}</div>
                <div class="credit-value" id="credit-value-author">{{ rev | tr('ui.menu.about.author.value') }}</div>
                <div class="credit-key" id="credit-key-look">{{ rev | tr('ui.menu.about.look') }}</div>
                <div class="credit-value" id="credit-value-look">{{ rev | tr('ui.menu.about.look.value') }}</div>
                <div class="credit-key" id="credit-key-type">{{ rev | tr('ui.menu.about.type') }}</div>
                <div class="credit-value" id="credit-value-type">{{ rev | tr('ui.menu.about.type.value') }}</div>
                <div class="credit-key" id="credit-key-art">{{ rev | tr('ui.menu.about.art') }}</div>
                <div class="credit-value" id="credit-value-art">{{ rev | tr('ui.menu.about.art.value') }}</div>
                <div class="page-divider" id="credits-divider"></div>
                <div id="credits-link">{{ rev | tr('ui.menu.about.link') }}</div>
            </div>
        </div>

        <!-- ================= new game: choice of the house (board 03) ================= -->
        <div id="screen-newgame" class="screen" data-if="screen == 'newgame'">
            <button class="house" data-for="h : houses" data-attr-id="'house-' + h.index"
                    data-style-left="h.left" data-style-top="h.top"
                    data-class-selected="sel_house == h.index" data-class-custom="h.custom"
                    data-event-click="house(h.index)" data-event-focus="house_focus(h.index)">
                <div class="house-frame"></div>
                <svg class="house-icon" data-attr-src="h.icon"/>
                <div class="house-badge">{{ sel_house == h.index ? chosen : h.badge }}</div>
                <div class="house-name">{{ h.name }}</div>
                <div class="house-line">{{ h.line }}</div>
                <div class="house-note" data-class-custom="h.custom">{{ h.note }}</div>
            </button>
            <div id="house-summary" data-if="has_house">
                <div id="hsum-portrait" data-style-decorator="hs.portrait"></div>
                <div id="hsum-name">{{ hs.name }}</div>
                <div id="hsum-head">{{ hs.head }}</div>
                <div id="hsum-head-line">{{ hs.head_line }}</div>
                <div id="hsum-members">{{ hs.members }}</div>
                <div class="page-divider" id="hsum-divider"></div>
                <div class="hsum-key" id="hsum-key-0">{{ rev | tr('ui.menu.newgame.sum.treasury') }}</div>
                <div class="hsum-value" id="hsum-value-0">{{ hs.treasury }}</div>
                <div class="hsum-key" id="hsum-key-1">{{ rev | tr('ui.menu.newgame.sum.prestige') }}</div>
                <div class="hsum-value" id="hsum-value-1">{{ hs.prestige }}</div>
                <div class="hsum-key" id="hsum-key-2">{{ rev | tr('ui.menu.newgame.sum.heir') }}</div>
                <div class="hsum-value" id="hsum-value-2">{{ hs.heir }}</div>
                <div id="hsum-blurb">{{ rev | tr('ui.menu.newgame.blurb.line1') }}<br/>{{ rev | tr('ui.menu.newgame.blurb.line2') }}</div>
            </div>
        </div>

        <!-- ================= own house (board 04) ================= -->
        <div id="screen-custom" class="screen" data-if="screen == 'custom'">
            <div class="cl" style="left: 128dp; top: 344dp; width: 508dp;" id="cl-surname">{{ rev | tr('ui.menu.custom.field.surname') }}</div>
            <input type="text" id="in-surname" class="cfield" style="left: 128dp; top: 374dp; width: 508dp;" maxlength="24"
                   data-attr-value="cf.surname" data-event-change="edit('surname')"/>
            <div class="cl" style="left: 664dp; top: 344dp; width: 508dp;" id="cl-house">{{ rev | tr('ui.menu.custom.field.house') }}</div>
            <input type="text" id="in-house" class="cfield" style="left: 664dp; top: 374dp; width: 508dp;" maxlength="24"
                   data-attr-value="cf.house" data-event-change="edit('house')"/>
            <div class="cl" style="left: 128dp; top: 454dp; width: 508dp;" id="cl-name">{{ rev | tr('ui.menu.custom.field.name') }}</div>
            <input type="text" id="in-name" class="cfield" style="left: 128dp; top: 484dp; width: 508dp;" maxlength="24"
                   data-attr-value="cf.name" data-event-change="edit('name')"/>
            <div class="cl" style="left: 664dp; top: 454dp; width: 508dp;" id="cl-patronymic">{{ rev | tr('ui.menu.custom.field.patronymic') }}</div>
            <input type="text" id="in-patronymic" class="cfield" style="left: 664dp; top: 484dp; width: 508dp;" maxlength="24"
                   data-attr-value="cf.patronymic" data-event-change="edit('patronymic')"/>
            <div class="cl" style="left: 128dp; top: 564dp; width: 1044dp;" id="cl-motto">{{ rev | tr('ui.menu.custom.field.motto') }}</div>
            <input type="text" id="in-motto" class="cfield" style="left: 128dp; top: 594dp; width: 1044dp;" maxlength="48"
                   data-attr-value="cf.motto" data-event-change="edit('motto')"/>
            <div class="cl" style="left: 128dp; top: 691dp; width: 508dp;" id="cl-look">{{ rev | tr('ui.menu.custom.field.look') }}</div>
            <button id="sel-look" class="cselect" style="left: 128dp; top: 722dp;" data-event-click="cycle('look')">
                <div class="cselect-text">{{ cf.look }}</div>
                <svg class="cselect-chevron" data-attr-src="icons + '/chevron@muted.svg'"/>
            </button>
            <div class="cl" style="left: 664dp; top: 691dp; width: 508dp;" id="cl-faith">{{ rev | tr('ui.menu.custom.field.faith') }}</div>
            <button id="sel-faith" class="cselect" style="left: 664dp; top: 722dp;" data-event-click="cycle('faith')">
                <div class="cselect-text">{{ cf.faith }}</div>
                <svg class="cselect-chevron" data-attr-src="icons + '/chevron@muted.svg'"/>
            </button>
            <div id="cust-reason" class="reason" data-if="!cust_ok">{{ rev | tr('ui.menu.custom.reason') }}</div>

            <div id="custom-summary">
                <div id="csum-portrait" data-style-decorator="cs.portrait"></div>
                <div id="csum-name">{{ cs.line1 }}<br/>{{ cs.line2 }}</div>
                <div id="csum-role">{{ rev | tr('ui.menu.custom.role') }}</div>
                <div id="csum-badge">{{ rev | tr('ui.menu.custom.badge') }}</div>
                <div class="page-divider" id="csum-divider"></div>
                <div id="csum-caption">{{ rev | tr('ui.menu.custom.heraldry') }}</div>
                <svg id="csum-shield" data-attr-src="icons + '/shield@green.svg'"/>
                <div id="csum-heraldry">{{ rev | tr('ui.menu.custom.heraldry.name') }}</div>
                <div id="csum-motto">{{ cs.motto }}</div>
                <div class="csum-colour" id="csum-green"></div>
                <div class="csum-colour" id="csum-gold"></div>
                <div id="csum-note">{{ rev | tr('ui.menu.custom.note') }}</div>
            </div>
        </div>

        <!-- ================= goal of the game (boards 05, 06) ================= -->
        <div id="screen-goal" class="screen" data-if="screen == 'goal'">
            <button class="goal" data-for="g : goals" data-attr-id="'goal-' + g.index"
                    data-style-left="g.left" data-style-top="g.top" data-style-width="g.width"
                    data-class-selected="sel_goal == g.index"
                    data-event-click="goal(g.index)" data-event-focus="goal(g.index)">
                <div class="goal-frame"></div>
                <svg class="goal-icon" data-attr-src="g.icon"/>
                <div class="goal-title">{{ g.title }}</div>
                <div class="goal-line">{{ g.line }}</div>
                <div class="goal-badge" data-if="sel_goal == g.index">{{ chosen }}</div>
            </button>
            <div id="goal-summary">
                <div id="gsum-caption">{{ rev | tr('ui.menu.goal.summary') }}</div>
                <div id="gsum-house">{{ gs.house }}</div>
                <div id="gsum-head">{{ gs.head }}</div>
                <div class="page-divider" id="gsum-divider-top"></div>
                <div id="gsum-keys">
                    <div>{{ rev | tr('ui.menu.goal.key.date') }}</div>
                    <div>{{ rev | tr('ui.menu.goal.key.goal') }}</div>
                    <div>{{ rev | tr('ui.menu.goal.key.mode') }}</div>
                    <div>{{ rev | tr('ui.menu.goal.key.treasury') }}</div>
                </div>
                <div id="gsum-values">
                    <div>{{ gs.date }}</div>
                    <div>{{ gs.goal }}</div>
                    <div>{{ gs.mode }}</div>
                    <div>{{ gs.treasury }}</div>
                </div>
                <div class="page-divider" id="gsum-divider-bottom"></div>
                <div id="gsum-blurb">{{ rev | tr('ui.menu.goal.blurb.line1') }}<br/>{{ rev | tr('ui.menu.goal.blurb.line2') }}<br/>{{ rev | tr('ui.menu.goal.blurb.line3') }}</div>
                <div id="gsum-paused">{{ rev | tr('ui.menu.goal.paused') }}</div>
            </div>
        </div>

        <!-- ================= settings (boards "МЕНЮ / Настройки / ...") ================= -->
        <div id="screen-settings" class="screen" data-if="screen == 'settings'">
            <div id="set-cats"></div>
            <button class="cat" data-for="c : cats" data-attr-id="'cat-' + c.index" data-style-top="c.top"
                    data-class-selected="sel_tab == c.index" data-event-click="tab(c.index)">
                <div class="cat-frame"></div>
                <div class="cat-text">{{ c.label }}</div>
            </button>
            <div id="set-note">{{ rev | tr('ui.menu.settings.note.line1') }}<br/>{{ rev | tr('ui.menu.settings.note.line2') }}</div>

            <div id="set-content">
                <div class="set-row" data-for="r : rows" data-attr-id="'row-' + r.index" data-style-top="r.top">
                    <div class="set-title">{{ r.title }}</div>
                    <div class="set-hint">{{ r.hint }}</div>
                    <button class="ctl" data-attr-id="'ctl-' + r.index"
                            data-class-k-dropdown="r.dropdown" data-class-k-toggle="r.toggle"
                            data-class-k-slider="r.slider" data-class-k-key="r.key" data-class-on="r.on"
                            data-event-click="setting(r.index)">
                        <div class="ctl-text">{{ r.value }}</div>
                        <svg class="ctl-chev" data-attr-src="icons + '/chevron@muted.svg'"/>
                        <div class="tg-track"></div>
                        <div class="tg-thumb"></div>
                        <div class="tg-text">{{ r.value }}</div>
                        <div class="sl-track"></div>
                        <div class="sl-value" data-style-width="r.fill"></div>
                        <div class="sl-thumb" data-style-left="r.thumb"></div>
                        <div class="sl-text">{{ r.value }}</div>
                        <div class="ctl-frame"></div>
                    </button>
                    <div class="set-div" data-if="r.index &lt; 5"></div>
                </div>
            </div>

            <div id="set-msg" data-if="set_show" data-class-ok="!set_dirty">{{ set_msg }}</div>
            <button id="btn-defaults" class="btn" data-event-click="defaults()"><span class="btn-text">{{ rev | tr('ui.menu.settings.defaults') }}</span></button>
            <button id="btn-apply" class="btn btn-primary" data-class-is-disabled="!set_dirty" data-event-click="apply()"><span class="btn-text">{{ rev | tr('ui.menu.settings.apply') }}</span></button>
        </div>

        <!-- ================= next step of the start flow (boards 03 to 05) ================= -->
        <div id="screen-next" class="screen" data-if="screen == 'newgame' || screen == 'custom' || screen == 'goal'">
            <button id="btn-next" class="btn btn-primary" data-class-is-disabled="!next_ok" data-event-click="next()">
                <svg data-attr-src="next_icon"/><span class="btn-text">{{ next_label }}</span></button>
        </div>

        <!-- ================= world: preparation and "Мир готов" (boards "Подготовка мира", "Мир готов") ================= -->
        <div id="screen-world" class="screen" data-if="screen == 'world'">
            <div id="wd-title" data-class-ready="wv.ready">{{ wv.title }}</div>
            <div id="wd-house" data-class-ready="wv.ready">{{ wv.house_line }}</div>
            <div class="wd-stage" id="wd-s0" data-if="!wv.ready" data-class-active="wv.stage == 0">{{ wv.stage0 }}</div>
            <div class="wd-stage" id="wd-s1" data-if="!wv.ready" data-class-active="wv.stage == 1">{{ wv.stage1 }}</div>
            <div class="wd-stage" id="wd-s2" data-if="!wv.ready" data-class-active="wv.stage == 2">{{ wv.stage2 }}</div>
            <div id="wd-ready-text" data-if="wv.ready">{{ rev | tr('ui.menu.world.ready.line1') }}<br/>{{ rev | tr('ui.menu.world.ready.line2') }}</div>
            <div id="wd-track"><div id="wd-bar" data-style-width="wv.bar"></div></div>
            <div id="wd-percent">{{ wv.percent }}</div>
            <div id="wd-hint" data-if="!wv.ready">{{ rev | tr('ui.menu.world.hint') }}</div>
            <div id="wd-note" data-if="wv.ready">{{ rev | tr('ui.menu.world.ready.note') }}</div>
            <button id="btn-cancel" class="btn" data-if="!wv.ready" data-event-click="back()"><span class="btn-text">{{ rev | tr('ui.menu.world.cancel') }}</span></button>
            <button id="btn-enter" class="btn btn-primary" data-if="wv.ready" data-event-click="enter()">
                <svg data-attr-src="icons + '/play@gold.svg'"/><span class="btn-text">{{ wv.enter }}</span></button>
        </div>

        <!-- ================= overview of the start screens (board "Обзор стартовых экранов") ================= -->
        <div id="screen-overview" class="screen" data-if="screen == 'overview'">
            <div id="ov-eyebrow">{{ rev | tr('ui.menu.overview.caption') }}</div>
            <div id="ov-title">{{ rev | tr('ui.menu.overview.title') }}</div>
            <div id="ov-subtitle">{{ rev | tr('ui.menu.overview.subtitle') }}</div>
            <div class="ov-divider"></div>
            <button class="ov-card" data-for="c : cards" data-attr-id="'card-' + c.index"
                    data-style-left="c.left" data-style-top="c.top" data-class-is-disabled="!c.enabled"
                    data-attr-title="c.hint" data-event-click="card(c.index)">
                <div class="ov-number">{{ c.number }}</div>
                <div class="ov-card-title">{{ c.title }}</div>
                <div class="ov-card-caption">{{ c.caption }}</div>
            </button>
            <div id="ov-discuss">{{ rev | tr('ui.menu.overview.discuss') }}</div>
            <div id="ov-note">{{ rev | tr('ui.menu.overview.note.line1') }}<br/>{{ rev | tr('ui.menu.overview.note.line2') }}<br/>{{ rev | tr('ui.menu.overview.note.line3') }}</div>
        </div>
    </div>

    <!-- ================= dialogs (boards "МЕНЮ / Диалог / ...") ================= -->
    <div id="dialog-backdrop" data-if="dialog != ''">
        <div id="dialog-exit" class="dialog" data-if="dialog == 'exit'">
            <div class="dialog-frame"></div>
            <div class="dialog-rule"></div>
            <div class="dialog-title">{{ rev | tr('ui.menu.exit.title') }}</div>
            <div class="dialog-text" id="dialog-exit-text">{{ rev | tr('ui.menu.exit.text') }}</div>
            <button id="dlg-stay" class="btn" data-event-click="dialog('stay')"><span class="btn-text">{{ rev | tr('ui.menu.exit.stay') }}</span></button>
            <button id="dlg-exit" class="btn btn-primary" data-event-click="dialog('exit')"><span class="btn-text">{{ rev | tr('ui.menu.item.exit') }}</span></button>
        </div>
        <div id="dialog-unavailable" class="dialog" data-if="dialog == 'unavailable'">
            <div class="dialog-frame"></div>
            <div class="dialog-rule"></div>
            <div class="dialog-title">{{ rev | tr('ui.menu.unavailable.title') }}</div>
            <div class="dialog-text" id="dialog-unavailable-text">{{ rev | tr('ui.menu.unavailable.line1') }}<br/>{{ rev | tr('ui.menu.unavailable.line2') }}<br/>{{ rev | tr('ui.menu.unavailable.line3') }}</div>
            <button id="dlg-back" class="btn btn-primary" data-event-click="dialog('back')"><span class="btn-text">{{ rev | tr('ui.menu.unavailable.button') }}</span></button>
        </div>
        <div id="dialog-save" class="dialog" data-if="dialog == 'save'">
            <div class="dialog-frame"></div>
            <div class="dialog-rule"></div>
            <div class="dialog-title">{{ rev | tr('ui.menu.settings.save.title') }}</div>
            <div class="dialog-text" id="dialog-save-text">{{ sd.save_line1 }}<br/>{{ rev | tr('ui.menu.settings.save.line2') }}</div>
            <button id="dlg-save-apply" class="btn btn-primary" data-event-click="dialog('apply')"><span class="btn-text">{{ rev | tr('ui.menu.settings.apply') }}</span></button>
            <button id="dlg-save-discard" class="btn" data-event-click="dialog('discard')"><span class="btn-text">{{ rev | tr('ui.menu.settings.save.discard') }}</span></button>
            <button id="dlg-save-return" class="btn" data-event-click="dialog('return')"><span class="btn-text">{{ rev | tr('ui.menu.settings.save.return') }}</span></button>
        </div>
        <div id="dialog-reset" class="dialog" data-if="dialog == 'reset'">
            <div class="dialog-frame"></div>
            <div class="dialog-rule"></div>
            <div class="dialog-title">{{ rev | tr('ui.menu.settings.reset.title') }}</div>
            <div class="dialog-text" id="dialog-reset-text">{{ rev | tr('ui.menu.settings.reset.line1') }}<br/>{{ rev | tr('ui.menu.settings.reset.line2') }}</div>
            <button id="dlg-reset-cancel" class="btn" data-event-click="dialog('cancel')"><span class="btn-text">{{ rev | tr('ui.menu.settings.reset.cancel') }}</span></button>
            <button id="dlg-reset-do" class="btn btn-primary" data-event-click="dialog('reset')"><span class="btn-text">{{ rev | tr('ui.menu.settings.reset.button') }}</span></button>
        </div>
        <div id="dialog-rebind" class="dialog" data-if="dialog == 'rebind'">
            <div class="dialog-frame"></div>
            <div class="dialog-rule"></div>
            <div class="dialog-title">{{ rev | tr('ui.menu.settings.rebind.title') }}</div>
            <div class="dialog-text" id="dialog-rebind-text">{{ sd.rebind_action }}<br/>{{ sd.rebind_line }}</div>
            <div id="rebind-badge"><div id="rebind-badge-text">{{ sd.rebind_badge }}</div></div>
            <button id="dlg-rebind-cancel" class="btn" data-event-click="dialog('cancel')"><span class="btn-text">{{ rev | tr('ui.menu.settings.rebind.cancel') }}</span></button>
            <button id="dlg-rebind-save" class="btn btn-primary" data-event-click="dialog('commit')"><span class="btn-text">{{ rev | tr('ui.menu.settings.rebind.save') }}</span></button>
        </div>
    </div>

</div>
</body>
</rml>
