    text-align: center;
    font-size: $type_13;
    font-weight: bold;
    line-height: 28dp;
    color: $muted;
}

.house.selected .house-badge {
    background-color: $green;
    color: $light;
}

.house-name {
    position: absolute;
    left: 22dp;
    top: 87dp;
