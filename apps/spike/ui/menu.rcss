/* ---- own house (board 04) */
.cl {
    position: absolute;
    font-size: $type_14;
    color: $muted;
    white-space: nowrap;
}

input.cfield {
    display: block;
    position: absolute;
    box-sizing: border-box;
    height: 50dp;
    padding: 0 15dp;
    background-color: $paper;
    border: $stroke_hairline $line;
    border-radius: $radius;
    font-family: $sans;
    font-size: $type_18;
    line-height: 48dp;
    color: $text;
    pointer-events: auto;
    tab-index: auto;
    cursor: text;
}

input.cfield:focus {
    padding: 0 14dp;
    border: $focus_ring $gold;
}

.cselect {
    display: block;
    position: absolute;
    box-sizing: border-box;
    width: 508dp;
    height: 48dp;
    margin: 0;
    padding: 0;
    border: 0dp transparent;
    background-color: $paper2;
    text-align: left;
    tab-index: auto;
    cursor: pointer;
    pointer-events: auto;
}

.cselect:hover {
    background-color: $line;
}

.kbd .cselect:focus {
    border: $focus_ring $gold;
}

.cselect-text {
    position: absolute;
    left: 16dp;
    top: 12dp;
    width: 450dp;
    font-size: $type_17;
    color: $text;
    white-space: nowrap;
}

.cselect-chevron {
    position: absolute;
    left: 474dp;
    top: 12dp;
    width: $icon_size;
    height: $icon_size;
    transform: rotate(90deg);
}

#cust-reason {
    position: absolute;
    left: 420dp;
    top: 935dp;
    width: 940dp;
    white-space: nowrap;
}

