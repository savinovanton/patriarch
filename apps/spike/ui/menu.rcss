.mi {
    display: block;
    position: absolute;
    left: 146dp;
    width: 548dp;
    margin: 0;
    padding: 0;
    border: 0dp transparent;
    background-color: $ink_a86;
    text-align: left;
    tab-index: auto;
    cursor: pointer;
    pointer-events: auto;
}

.mi.is-disabled {
    background-color: $ink_a52;
    tab-index: none;
    cursor: default;
}

.mi.selected {
    background-color: $paper;
}

.mi-edge {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 4dp;
    height: 100%;
    background-color: $gold;
}

.mi.selected .mi-edge {
    display: block;
}

.mi-text {
    position: absolute;
    left: 0;
    top: 9dp;
    width: 484dp;
    font-family: $serif;
    font-size: $type_26;
    color: $light;
    white-space: nowrap;
}

.mi.primary .mi-text {
    top: 16dp;
}

.mi.is-disabled .mi-text {
    color: $quiet;
}

.mi.selected .mi-text {
    left: 24dp;
    color: $ink;
}

.mi-chevron {
    display: none;
    position: absolute;
    left: 504dp;
    top: 15dp;
    width: $icon_size;
    height: $icon_size;
}

.mi.primary .mi-chevron {
    top: 22dp;
}

.mi.selected .mi-chevron {
