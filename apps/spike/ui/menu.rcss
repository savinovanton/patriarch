/* Start menu (UI-D12, issue 284; geometry in data/ui/layout/menu_boards.pd, boards "МЕНЮ / ..." at 1920x1080: 1dp = 1
   design pixel). The art, the shade and the contrast strip cover the whole window; everything else sits on the
   `stage`, a 1920x1080dp canvas centred horizontally, so the layout is the drawn one at every aspect ratio.
   The document is modal and full screen: it takes the mouse everywhere (pointer-events is inherited). */
#menu {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: $ink;
    pointer-events: auto;
}

#menu-paper {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: $paper;
}

/* The concept art is a temporary placeholder (issue 254): the image of the mockup, fitted to cover the window. */
#menu-art {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#menu-shade {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: $ink_a8;
}

#menu-shade.dim {
    background-color: $ink_a72;
}

/* The strip of the board (0..910 of the canvas) and its continuation to the left edge of a wider window. */
#menu-contrast,
#menu-contrast-left {
    position: absolute;
    top: 0;
    height: 100%;
    background-color: $ink_a33;
}

#menu-contrast {
    left: 50%;
    margin-left: -960dp;
    width: 910dp;
}

#menu-contrast-left {
    left: 0;
    margin-left: -960dp;
    width: 50%;
}

#stage {
    position: absolute;
    left: 50%;
    margin-left: -960dp;
    top: 0;
    width: 1920dp;
    height: 1080dp;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920dp;
    height: 1080dp;
    /* The screens overlap each other: only the controls (buttons, the list) take the mouse, so that a control of
       one screen is never covered by the empty box of the next. */
    pointer-events: none;
}

/* A dialog is open: the screen behind takes no Tab (the backdrop also covers the mouse). */
#stage.blocked button {
    tab-index: none;
}

#menu-copyright {
    position: absolute;
    left: 54dp;
    top: 1036dp;
    width: 1160dp;
    font-size: $type_12;
    color: $quiet;
    white-space: nowrap;
}

#menu-region {
    position: absolute;
    left: 1510dp;
    top: 1033dp;
    width: 350dp;
    font-family: $serif;
    font-size: $type_15;
    color: $gold;
    white-space: nowrap;
}

#menu-copyright.overview,
#menu-region.overview {
    color: $muted;
}

/* ---- main menu */
