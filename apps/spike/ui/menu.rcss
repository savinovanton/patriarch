}

/* ---- new game: the choice of the house (board 03) */
.house {
    display: block;
    position: absolute;
    box-sizing: border-box;
    width: 510dp;
    height: 236dp;
    margin: 0;
    padding: 0;
    border: 0dp transparent;
    background-color: $paper2;
    text-align: left;
    tab-index: auto;
    cursor: pointer;
    pointer-events: auto;
}

.house.selected {
    background-color: $paper;
}

.house-frame,
.goal-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    border: $stroke_hairline $line;
}

.house:hover .house-frame,
.goal:hover .goal-frame {
    border-color: $green;
}

.house.selected .house-frame,
.goal.selected .goal-frame {
    border: $stroke_window $green;
}

.kbd .house:focus .house-frame,
.kbd .goal:focus .goal-frame {
    border: $focus_ring $gold;
}

.house-icon {
    position: absolute;
    left: 22dp;
    top: 24dp;
    width: 31dp;
