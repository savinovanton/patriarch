/* ---- load */
#save-list {
    position: absolute;
    left: 128dp;
    top: 340dp;
    width: 1044dp;
    height: 528dp;
    overflow-y: auto;
    pointer-events: auto;
}

scrollbarvertical {
    width: 12dp;
}

scrollbarvertical slidertrack {
    background-color: $paper2;
}

scrollbarvertical sliderbar {
    width: 12dp;
    min-height: 24dp;
    background-color: $line;
    border-radius: $radius;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

.save {
    display: block;
    position: relative;
    box-sizing: border-box;
    width: 100%;
    height: 150dp;
    margin: 0 0 21dp 0;
    padding: 0;
    border: 0dp transparent;
    background-color: $paper2;
    text-align: left;
    tab-index: auto;
    cursor: pointer;
    pointer-events: auto;
}

.save.selected {
    background-color: $paper;
}

/* The frame is a child: its width changes with the state while the texts keep their places. */
.save-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    border: $stroke_hairline $line;
}

.save:hover .save-frame {
    border-color: $green;
}

.save.selected .save-frame {
    border: $stroke_window $green;
}

.kbd .save:focus .save-frame {
    border: $focus_ring $gold;
}

.save-icon {
    position: absolute;
    left: 24dp;
    top: 26dp;
    width: $icon_size;
    height: $icon_size;
}

