<rml>
<head>
    <title>Time bar</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="components.rcss"/>
    <link type="text/rcss" href="timebar.rcss"/>
</head>
<body data-model="timebar">
<div id="date-block">
    <div id="date">{{ date_text }}</div>
    <div id="calendar">{{ t.calendar }}</div>
</div>
<div id="controls">
    <div class="badge badge-dark" id="badge-paused" data-if="paused">{{ t.paused }}</div>
    <div id="pause" class="ctl" data-class-paused="paused" data-attr-title="t.pause_title" data-event-click="toggle_pause()">
        <svg data-attr-src="icons + '/pause@gold.svg'"/>
    </div>
    <div class="spd" data-for="s : speeds" data-attr-id="'spd-' + s.n" data-class-on="s.n &lt;= shown" data-attr-title="s.title"
         data-event-click="set_speed(s.n)"></div>
    <div id="hint">{{ t.hint }}</div>
</div>
</body>
</rml>
