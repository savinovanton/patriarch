/* Credits window ("Титры") in the theme "Rodovaya kantselyariya" (dollar-prefixed tokens of data/ui/theme.pd, docs/dev/ui-design.md).
   Temporary test layout: a centred panel with a scrolling list. */

h1, h2, p {
    display: block;
}

body {
    pointer-events: none;
}

#window {
    pointer-events: auto;
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -300dp;
    margin-top: -280dp;
    width: 600dp;
    padding: 14dp 16dp;
    background-color: $panel_a95;
    border: 1dp $rule;
    border-radius: 2dp;
}

h1 {
    font-family: "PT Serif";
    font-size: 24dp;
    font-weight: bold;
    color: $light;
    margin-bottom: 8dp;
}

h2 {
    font-family: "PT Serif";
    font-size: 14dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
    color: $quiet;
    margin: 10dp 0 5dp 0;
}

#list {
    height: 460dp;
    padding: 0 8dp;
    overflow-y: scroll;
    background-color: $ink;
    border: 1dp $rule;
}

#empty {
    color: $quiet;
    margin-top: 10dp;
}

.item {
    margin-bottom: 10dp;
}

.item-name {
    color: $light;
    font-size: 15dp;
    font-weight: bold;
}

.item-meta {
    color: $quiet;
    font-size: 12dp;
}

.item-text {
    color: $quiet;
    font-size: 13dp;
    margin-top: 2dp;
}

#actions {
    margin-top: 10dp;
    text-align: right;
}

.btn {
    display: inline-block;
    padding: 5dp 12dp;
    background-color: $raised;
    border: 1dp $gold;
    border-radius: 2dp;
    color: $light;
    font-size: 13dp;
}

.btn:hover {
    background-color: $rule;
    color: $light;
}

.btn:active {
    background-color: $panel;
}

scrollbarvertical {
    width: 12dp;
}

scrollbarvertical slidertrack {
    background-color: $ink;
}

scrollbarvertical sliderbar {
    width: 12dp;
    min-height: 24dp;
    background-color: $rule;
    border-radius: 2dp;
}

scrollbarvertical sliderbar:hover {
    background-color: $quiet;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}
