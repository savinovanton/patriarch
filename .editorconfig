root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cpp,hpp,h,cc,cmake}]
end_of_line = lf

[CMakeLists.txt]
end_of_line = lf

[*.ps1]
end_of_line = crlf
