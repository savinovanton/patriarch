format_version = 1

# Должности двора M1 (court-model §11.1, §11.2; Q2 #360): 12 должностей и фаворит. slot — стабильный
# номер типа 1...63, записывается в сейвы; порядок объектов на него не влияет. Все числа [предл.]:
# они продублированы в sim::CourtRules::defaults(), тест следит за совпадением. Исторические названия
# и даты [проверить] отдельной сверкой данных.
#   seats          — правила мест: fixed (slots мест), per_crown_province (по месту в государевой
#                    провинции видов kinds, не более max), listed (провинции сценария, не более max);
#   requirements   — min_age и sex_allowed жёсткие; min_honor и skills мягкие (допускают
#                    «исключительный порядок»); not_traits жёсткие (черты из data/traits);
#   skill_weights  — очки полезности за уровень навыка (слагаемое «способности»);
#   salary_kop     — жалованье, копеек в месяц; honor_on_assign / honor_monthly — честь рода;
#   decision_delay_days — дней от открытия вакансии до решения государя;
#   from_date / to_date — окно дат (губернатор — после реформы 1708, #511);
#   administrator_priority — какой держатель провинции управляет ею (больше — важнее);
#   grants_trait   — черта держателя (фаворит); council_vote_weight — голос в Совете для E34.
# Названия и описания — ключи data/loc/<язык>/court.pd.

office "bedchamberman" {
    slot = 1
    group = court
    name_key = "office.bedchamberman.name"
    desc_key = "office.bedchamberman.desc"
    appointer = emperor
    seats = { rule = fixed slots = 2 }
    requirements = { min_age = 16  sex_allowed = male  min_honor = 100 }
    skill_weights = { diplomacy = 2 intrigue = 2 }
    salary_kop = 600
    honor_on_assign = 10
    honor_monthly = 1
    decision_delay_days = 90
}

