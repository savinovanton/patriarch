# Претензии на престол (§8.4): слагаемые claim_strength 0...100.
claim_rules "main" {
    # Основания претензии (§8.4).
    basis = {
        marriage = 15
        designation_appointment = 30
        designation_other = 10
        kin_max_degree = 4
        force_min = 25
        force_supporters = 2
        max_per_house = 3
    }

    # Слагаемые поддержки претензии (§8.4).
    support = {
        guard_k_pm = 150
        guard_cap = 15
        houses_max = 20
        council_max = 15
        prestige_div = 10
        prestige_cap = 10
    }

    # Штраф вне линии, смягчения и прочее (§8.4).
    penalty = {
        outside_line = -30
        relief_marriage = 15
        relief_appointment = 30
        relief_council_max = 20
        relief_church = 10
        relief_guard = 10
        relief_guard_from = 40
        phase4_pm = 500
        illegitimate = -15
        disgraced = -10
    }

    # Кровное родство по степени 1...5 (пятая — «пять и далее») и место в порядке престолонаследия E8.
    blood = [ 40, 32, 24, 16, 8 ]
    legal = [ 15, 8, 4 ]
}
