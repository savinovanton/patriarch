format_version = 1

# Баланс кризиса и престола M1 (throne-crisis-model §8, §11, ADR-0010): веса компонентов стабильности,
# пороги фаз и полос, защитное окно, подозрение и донос, заговор, окно переворота, позиции ИИ-родов,
# последствия и основания претензий. Все числа [предл.]: они продублированы в sim::crisis::CrisisBalance
# и ClaimRules (списки PAT_CRISIS_BALANCE_FIELDS и PAT_CLAIM_RULE_FIELDS), тест следит за совпадением;
# калибровка — E12-T21 (100 прогонов × 50 лет). Последствия переворота (группа consequences) числа
# порядка; их набор может дополниться ступенью казней после решения владельца (#594).
# Суффиксы: _pm — доли в промилле (1000 = ×1,0); _x100 — сотые доли пункта; _kop — копейки; _k — множитель;
# _days / _months / _year — календарные величины. Три проекта императора — data/crisis/projects.pd.

crisis_balance "main" {
    # Стабильность (throne-crisis §8.1): основа, инерция, гистерезис полос.
    stability = {
        base = 50
        step_cap_x100 = 500
        band_up_margin = 3
        legacy_decay_pm = 40
        legacy_snap_x100 = 50
    }

