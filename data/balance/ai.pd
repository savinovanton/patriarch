format_version = 1

# Баланс [предл.], docs/dev/ai-model.md §§6,8,13. Файл равен AiRules::defaults().
# Не включает системы ИИ и не меняет совместимость сценария до E17-T19.
ai_rules "main" {
    budget = {
        quota_wu = 12000
        carry_pm = 500
        pass_wu = 50
        goal_wu = 20
        filter_rows = 8
        filter_wu = 1
        object_wu = 2
