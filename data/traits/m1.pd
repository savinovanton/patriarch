format_version = 1

# The 25-trait M1 pool follows GDD 01 section 4. Stable nonzero slots address sim's u16 trait slots.
# All numeric effects, AI hints and inheritance chances below are initial balance [предл.]. They
# describe definitions only: applying effects, inheritance and scenario assignment are later tasks.
# Skill effects are skill points; modifiers are points of the named character scale. Opposites are
# reciprocal. Slots must stay stable when definitions are reordered or extended.

# ---- Personality ------------------------------------------------------------------------------

trait "ambitious" {
    slot = 1
    category = personality
    name_key = "trait.ambitious.name"
    desc_key = "trait.ambitious.desc"
    skills = { diplomacy = 1 intrigue = 2 }
    modifiers = { ambition = 30 }
    ai_hint = { seeks_promotion = 2 joins_plots = 1 }
}

trait "cautious" {
    slot = 2
    category = personality
    name_key = "trait.cautious.name"
    desc_key = "trait.cautious.desc"
    skills = { intrigue = 1 martial = -1 }
}

trait "cruel" {
    slot = 3
    category = personality
    name_key = "trait.cruel.name"
    desc_key = "trait.cruel.desc"
    opposite = trait:merciful
    skills = { martial = 1 diplomacy = -1 }
}

trait "merciful" {
    slot = 4
    category = personality
    name_key = "trait.merciful.name"
    desc_key = "trait.merciful.desc"
    opposite = trait:cruel
    skills = { diplomacy = 1 }
    modifiers = { piety = 5 }
}

trait "generous" {
    slot = 5
    category = personality
    name_key = "trait.generous.name"
    desc_key = "trait.generous.desc"
    opposite = trait:greedy
    skills = { diplomacy = 1 stewardship = -1 }
}

trait "greedy" {
    slot = 6
    category = personality
    name_key = "trait.greedy.name"
    desc_key = "trait.greedy.desc"
    opposite = trait:generous
    skills = { stewardship = 1 diplomacy = -1 }
}

trait "devout" {
    slot = 7
    category = personality
    name_key = "trait.devout.name"
    desc_key = "trait.devout.desc"
    opposite = trait:freethinker
    skills = { learning = 1 }
    modifiers = { piety = 20 }
}

trait "freethinker" {
    slot = 8
    category = personality
    name_key = "trait.freethinker.name"
    desc_key = "trait.freethinker.desc"
    opposite = trait:devout
    skills = { learning = 2 }
    modifiers = { piety = -10 }
}

trait "proud" {
    slot = 9
    category = personality
    name_key = "trait.proud.name"
    desc_key = "trait.proud.desc"
    skills = { diplomacy = -1 }
    modifiers = { ambition = 15 }
}

trait "lazy" {
    slot = 10
    category = personality
    name_key = "trait.lazy.name"
    desc_key = "trait.lazy.desc"
    skills = { stewardship = -2 }
    modifiers = { stress = -5 }
}

