format_version = 1

# Пул мужских имён (E7-T09, GDD 01 §2.1; схема — docs/dev/data-reference.md, вид given_name; правила — docs/dev/names.md).
# Id имени записывается в колонку name персонажа. Формы отчества записаны явно (без морфологии):
# patronymic_son_key — для сына, patronymic_daughter_key — для дочери. Тексты — data/loc/ru/names.pd.
# weight — относительная частота в пуле [предл.]: более частые православные имена знати выше.
# Это общий пул имён, а не список реальных лиц: стартовые персонажи сценария задаёт E30.
# [проверить] В 1703 году отчество на -ович/-евич было привилегией высшего круга, остальные писались
# «Иванов сын»; в игре все члены рода получают отчество единообразно (упрощение).

given_name "ivan" {
    sex = male
    weight = 30
    name_key = "name.given.ivan"
    patronymic_son_key = "name.patronymic.ivan.son"
    patronymic_daughter_key = "name.patronymic.ivan.daughter"
}

