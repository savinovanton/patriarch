format_version = 1

# Правила выбора имени новорождённому (E7-T09, вид naming_rules; docs/dev/names.md).
# Прибавки к весу имени в пуле (в единицах given_name.weight) [предл.]: имя отца для сына (матери для
# дочери) и имя деда по той же линии. При сумме весов около 400 это примерно 10 % и 6 % шанса на имя.

naming_rules "main" {
    parent_bonus = 40
    grandparent_bonus = 25
}
