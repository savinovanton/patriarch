format_version = 1

# Пул портретов (E7-T09, вид portrait): какие id доступны полу и возрастной полосе. Сами гравюры
# подключает E26 (FR-UI-8), пока id зарезервированы под заглушки. Раскладка id [предл.]:
# 100·(пол: 1 — мужской, 2 — женский) + 10·(полоса: 0 ребёнок … 4 старость) + номер.
# Нужен хотя бы один портрет на каждый пол и полосу; id уникален и не равен 0 (0 — «без портрета»).

portrait "m_child_1" { sex = male  stage = child  portrait_id = 101 }
