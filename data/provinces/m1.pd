format_version = 1

# Development definitions for the 20-province procedural PMD1 map. Keys follow decision #201:
# province id 1 maps to p0001, id 20 to p0020. These are not historical boundaries or names.
# Owners and the historical scenario are assigned by E30/Geo, not by this definition pool.

province "p0001" { name_key = "province.p0001.name" kind = province_kind:rural }
