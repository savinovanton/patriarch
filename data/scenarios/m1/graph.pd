format_version = 1

# Province graph for the simulation (E16-T04, docs/dev/army-model.md section 5).
# Generated from the map; edit by hand only `road` of an edge (road = tract). Regenerate:
#   mapgen (--out MAP.pmd ... | --info MAP.pmd) --export-graph graph.pd --metres-per-px 5000 --graph-id m1
# A test compares nodes, edges and lengths with the map; roads are not compared.

