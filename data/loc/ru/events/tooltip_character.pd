format_version = 1

# Шаблоны автотултипов каталога триггеров: персонаж и род (E11-T07). Ключи — tooltip_key() в src/sim/events/catalog.cpp:
# tooltip.trigger.<имя> (условие), .not (предикат с = no), .fail (причина недоступности варианта).
# Параметры: подписи аргументов записи ({trait}, {target}, ...), у значений — {need} (условие целиком, собирается из
# tooltip.cmp.*) и {have} (текущее значение); у значения с видом (skill.martial) — {kind}. Тесты проверяют полноту
# (tests/event_triggers_character_test.cpp). Тексты [проверить] на тон.

# ---- Сравнения: {value} — число из записи (общие для всех значений каталога) ----
tooltip.cmp.ge = "не менее {value}"
tooltip.cmp.gt = "более {value}"
tooltip.cmp.le = "не более {value}"
tooltip.cmp.lt = "менее {value}"
tooltip.cmp.eq = "ровно {value}"
tooltip.cmp.ne = "не {value}"

# Оболочка причины недоступности для предиката, требуемого как = no: {text} — текст ключа .not
tooltip.fail.required = "Требуется: {text}"

# ---- Предикаты ----
tooltip.trigger.is_adult = "Совершеннолетний"
tooltip.trigger.is_adult.not = "Несовершеннолетний"
tooltip.trigger.is_adult.fail = "Требуется: совершеннолетие"

tooltip.trigger.is_female = "Женщина"
