format_version = 1

# Кризис и престол (E12-T04): названия компонентов стабильности (crisis.component.*), причин их вклада
# (crisis.reason.*), фаз кризиса (crisis.phase.<имя>.name/hint; имена smoulder, unrest, plots, coup_window по номерам 0...3), полос стабильности (crisis.band.*) и
# проектов императора (crisis.project.*). Ключи проектов также записаны в data/crisis/projects.pd;
# остальные читает код (sim/crisis_text.cpp). Тексты [проверить] на тон и историчность.

