format_version = 1

# Русские названия объектов экономики (E9-T16). Ключи — поле name_key типов зданий из
# data/economy/buildings.pd. Таблица локализации, а не определения контента (docs/dev/localization.md).

building.mill = "Мельница"
building.manufactory = "Суконная мануфактура"
building.works = "Железоделательный завод"
building.tract = "Тракт"
building.wharf = "Пристань"
building.ostrog = "Острог"
building.church = "Церковь"
building.granary = "Амбар"

# Описания эффектов зданий (E9-T17): ключ — name_key здания + ".desc". Подсказка в окне провинции
# показывает их рядом с названием; числа в подсказке берутся из разложения (Breakdown), а не отсюда.
building.mill.desc = "Мелет зерно крупнее и быстрее: выпуск хлеба растёт."
building.manufactory.desc = "Суконное дело: выпуск сукна растёт. Строится в городах и промышленных провинциях."
building.works.desc = "Домны и кузницы: выпуск железа растёт. Строится только в промышленных провинциях."
building.tract.desc = "Проезжая дорога: воевода дотягивается до уездов, контроль растёт."
building.wharf.desc = "Причал и снасти: улов рыбы растёт. Строится в портовых провинциях."
building.ostrog.desc = "Гарнизон острога держит край в повиновении: контроль растёт, рекрутов в провинции больше. Строится на границе, в степи и на севере."
building.church.desc = "Приход ведёт книги и исповедует: контроль растёт, воеводе воровать труднее."
building.granary.desc = "Общественный запас хлеба: недород смягчается, нехватка зерна меньше бьёт по достатку."
