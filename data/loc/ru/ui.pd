format_version = 1

# Русские строки интерфейса (E4-T06). Это таблица локализации, а не определения контента: файлы
# в data/loc/<язык>/ читает модуль pat::loc (docs/dev/localization.md), загрузчик контента их пропускает.
#
# Ключ — идентификатор с точками: ui.<окно>.<смысл>. Параметры: {имя}; число с неразрывными
# пробелами между тысячами: {n:group}; форма слова по числу: {n:plural(год|года|лет)}.
# Литеральные скобки пишутся {{ и }}.
#
# Строки соответствуют тому, что сейчас зашито в HUD спайка (apps/spike/ui/hud.rml, timebar.rml,
# src/ui/hud_window.cpp) и в окне персонажа (character.rml, character_snapshot.*). HUD — временная
# тестовая раскладка; подключение окон к таблице — отдельная задача.

# ---- Общее -------------------------------------------------------------------------------------

ui.age.years = "{n} {n:plural(год|года|лет)}"
ui.fmt.number = "{n:group}"
ui.fmt.thousands = "{n} т"

# ---- Время и дата ------------------------------------------------------------------------------

ui.timebar.pause = "Пауза"
ui.date.long = "{day} {month} {year}"

ui.month.january = "января"
