ui.fmt.rouble = "{n:group} ₽"

ui.res.treasury = "Казна"
ui.res.prestige = "Престиж"
ui.res.influence = "Влияние"
ui.res.piety = "Благочестие"
ui.res.militia = "Ополчение"
ui.res.tooltip = "{label}: {value} ({note})"

# Третья строка ресурса: прирост в месяц, предел или поясняющая подпись.
ui.hud.res.delta = "{delta} / мес."
ui.hud.res.capacity = "из {n:group}"
ui.hud.res.influence.note = "при дворе"
ui.hud.res.piety.note = "благосклонность"

# Левая навигация. Пункт без готового экрана показан приглушённым с подсказкой ui.nav.soon.
ui.nav.dynasty = "Род"
ui.nav.holdings = "Владения"
ui.nav.court = "Двор"
ui.nav.treasury = "Казна"
ui.nav.church = "Церковь"
