format_version = 1

# Двор и должности (E10-T04): названия и описания должностей, ролей слуг и партий, тексты причин отказа
# (court.denial.*, параметры {a} и {b} — числа причины, court-model §7.3), слагаемых разложений
# (court.term.<код>, §9), причин команд (court.reason.*) и записей летописи (chronicle.court.*).
# Ключи названий и описаний также записаны в data/court/*.pd; остальные ключи читает код
# (sim/court_text.cpp). Названия должностей [проверить] по источникам.

# ---- Должности ----
office.bedchamberman.name = "Спальник"
office.bedchamberman.desc = "Личный слуга государя из знатных родов; близость к особе даёт влияние при дворе."
office.orderly.name = "Денщик"
office.orderly.desc = "Ординарец при государе из служилых людей; путь к военной карьере."
office.tsarevich_tutor.name = "Воспитатель царевича"
office.tsarevich_tutor.desc = "Наставник наследника престола; требует учёности и безупречной репутации."
office.court_steward.name = "Управитель двора"
office.court_steward.desc = "Ведает хозяйством и расходами двора."
office.voivode.name = "Воевода"
office.voivode.desc = "Управляет государевой провинцией: собирает налоги и держит порядок."
office.governor.name = "Губернатор"
office.governor.desc = "Правит областью с широкими полномочиями; должность вводится реформой 1708 года."
office.fortress_commandant.name = "Комендант"
office.fortress_commandant.desc = "Командует крепостью и гарнизоном государева города."
office.guards_colonel.name = "Полковник гвардии"
office.guards_colonel.desc = "Командует гвардейским полком, опорой государя в столице."
office.general.name = "Генерал"
office.general.desc = "Высший военачальник; ведёт армии государя."
office.ambassadorial_chief.name = "Глава Посольского приказа"
office.ambassadorial_chief.desc = "Ведает сношениями с иностранными державами."
office.treasurer.name = "Казначей"
office.treasurer.desc = "Возглавляет Приказ Большой казны и отвечает за доходы государства."
office.duma_boyar.name = "Боярин Думы"
office.duma_boyar.desc = "Член боярской Думы; голос в Совете государя."
office.favourite.name = "Фаворит"
office.favourite.desc = "Ближайший к государю человек; его слово весомо, а падение опасно."

