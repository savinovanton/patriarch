{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "patriarch",
  "version-string": "0.0.1",
  "builtin-baseline": "054bd01bec7f31492ec9ac063740cc984a0fe59e",
  "dependencies": [
    "doctest",
    "fmt",
    "zstd",
    "xxhash",
    "benchmark"
  ],
  "default-features": [
    "engine"
  ],
  "features": {
    "tracy": {
      "description": "Tracy profiler client for PATRIARCH_ENABLE_TRACY (off by default; see docs/dev/profiling.md).",
      "dependencies": [
        "tracy"
      ]
    },
    "engine": {
      "description": "Window, renderer and UI libraries; the Linux determinism job builds without them.",
      "dependencies": [
        "sdl3",
        {
          "name": "rmlui",
          "features": [
            "svg"
          ]
        },
        {
          "name": "freetype",
          "default-features": false
        }
      ]
    }
  }
}
